{
  "name": "claude-maestro",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client,mobile -c blue,magenta,green \"npm:dev:server\" \"npm:dev:client\" \"npm:dev:client:mobile\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite --force",
    "dev:client:mobile": "vite --force --config vite.mobile.config.ts",
    "build": "vite build && vite build --config vite.mobile.config.ts && tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.1.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "express": "^4.21.1",
    "marked": "^14.1.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "concurrently": "^9.1.0",
    "playwright": "^1.60.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
